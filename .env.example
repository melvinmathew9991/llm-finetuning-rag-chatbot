# "openai" (default) or "ollama"
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# Used when LLM_PROVIDER=ollama - run `ollama serve` and `ollama pull llama3` first
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Optional - where the bundled sample knowledge base lives. Seeded into the
# app's tmp/ working dir on first run only (never overwrites an existing one).
KB_SOURCE_DIR=data/kb

# Optional - text splitting for the vector index. CHUNK_OVERLAP only matters
# once a KB document exceeds CHUNK_SIZE characters (the bundled sample docs
# don't) - tune both together for larger, user-uploaded knowledge bases.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
